{
  "ReverseProxy": {
    "Routes": {
      "products-route": {
        "ClusterId": "products-cluster",
        "Match": {
          "Path": "/api/products/{**catch-all}"
        }
      },
      "users-route": {
        "ClusterId": "users-cluster",
        "Match": {
          "Path": "/api/users/{**catch-all}"
        }
      },
      "orders-route": {
        "ClusterId": "orders-cluster",
        "Match": {
          "Path": "/api/{**catch-all}"
        }
      },
      "products-swagger-route": {
        "ClusterId": "products-cluster",
        "Match": {
          "Path": "/openapi/products/{**catch-all}"
        },
        "Transforms": [
          {
            "PathRemovePrefix": "/openapi/products"
          }
        ]
      },
      "users-swagger-route": {
        "ClusterId": "users-cluster",
        "Match": {
          "Path": "/openapi/users/{**catch-all}"
        },
        "Transforms": [
          {
            "PathRemovePrefix": "/openapi/users"
          }
        ]
      },
      "orders-swagger-route": {
        "ClusterId": "orders-cluster",
        "Match": {
          "Path": "/openapi/orders/{**catch-all}"
        },
        "Transforms": [
          {
            "PathRemovePrefix": "/openapi/orders"
          }
        ]
      }
    },
    "Clusters": {
      "products-cluster": {
        "Destinations": {
          "destination1": {
            "Address": "http://products:8080/"
          }
        }
      },
      "users-cluster": {
        "Destinations": {
          "destination1": {
            "Address": "http://users:8080/"
          }
        }
      },
      "orders-cluster": {
        "Destinations": {
          "destination1": {
            "Address": "http://orders:8080/"
          }
        }
      }
    }
  }
}
